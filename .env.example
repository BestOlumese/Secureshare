# --- Database ---
# Postgres connection string used by Prisma.
#
# Set sslmode explicitly. `pg` currently treats `require` as `verify-full`, but
# v9 will change it to mean encryption without certificate verification — so a
# URL saying `require` silently gets weaker on upgrade. Say which you want:
#   sslmode=verify-full  - verify the CA and the hostname (use this)
#   sslmode=disable      - local development against a plain server
DATABASE_URL="postgresql://user:password@localhost:5432/secureshare?sslmode=verify-full"

# --- Auth (better-auth) ---
# Random secret used to sign sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public origin of the app. Used in invite and notification email links.
BETTER_AUTH_URL="http://localhost:3000"

# --- Email (SMTP) ---
# Sends login OTPs, invitations, sign-in alerts and new-message notifications.
SMTP_HOST=""
# Defaults to 587. Set to 465 to connect over implicit TLS.
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# --- File storage (UploadThing) ---
# Stores the encrypted attachment blobs.
UPLOADTHING_TOKEN=""

# --- Scheduled cleanup ---
# Bearer token for GET /api/cron/cleanup, which purges expired and fully
# deleted attachments from storage. Generate with: openssl rand -hex 32
# The route returns 503 until this is set.
CRON_SECRET=""
